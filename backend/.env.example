AVWX_TOKEN=your_api_token_here
# 逗號分隔；預設 http://localhost:5173,https://aerobrief.vercel.app
# CORS_ORIGINS=http://localhost:5173
# 額外允許的來源（Vercel preview 網域）；設為空字串可停用
# CORS_ORIGIN_REGEX=^https://aerobrief(-[a-z0-9]+)*\.vercel\.app$
# 每個 IP 每分鐘請求上限（0 = 停用）
# RATE_LIMIT_PER_MIN=120
# 部署在反向代理（Render / Fly / nginx）後請開啟，才能取得真實 client IP
# TRUST_PROXY=1
# 記憶體快取上限
# CACHE_MAX_ENTRIES=2000
